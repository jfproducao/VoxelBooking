# VoxelBooking Environment Configuration
# Production: the installer creates .env automatically during setup.
# Local/dev: copy this file to .env and adjust values before starting.

# ── Application ──
APP_NAME=VoxelBooking
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_LOCALE=en
FORCE_HTTPS=true

# Optional canonical HTTPS URL when a trusted proxy does not expose the public origin.
# AGENT_BASE_URL=https://booking.example.com
# Additional browser-client origins; exact HTTPS origins, comma-separated.
# Native clients need no entry. No wildcard, path, userinfo, or cookie access.
AGENT_ALLOWED_ORIGINS=

# ── Database ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=voxelbooking
DB_USERNAME=root
DB_PASSWORD=

# ── Mail ──
# Supported transports: smtp, resend, mailpit, log
#
# smtp   — Standard SMTP via PHPMailer (ports 465/587)
# resend — Resend HTTP API over HTTPS (port 443). Use this when your
#          hosting provider blocks outbound SMTP ports (common on
#          DigitalOcean, Hetzner, etc.). Set MAIL_PASSWORD to your
#          Resend API key. MAIL_HOST/PORT/ENCRYPTION are ignored.
# mailpit — Local dev email capture (localhost:1025)
# log     — Write to email_log table only, no outbound connection
#
# Database settings take precedence; these .env values are used as
# fallback only when a setting has NO row in the database (i.e., never
# configured via the admin UI).
MAIL_TRANSPORT=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# ── Node.js / Supabase migration target ──
# Keep unset while using the PHP runtime. For Node on Render, set DATABASE_URL
# in Render's environment to Supabase Connect > Session pooler (port 5432).
# The direct db.<project-ref>.supabase.co:5432 URL is IPv6-only on standard
# Supabase plans and cannot be reached from Render unless the project has IPv4.
# Pooler host and username must be copied from Supabase; they differ from direct.
# DATABASE_URL=postgresql://postgres.drfislzpsmdxypzmsdqq:YOUR_PASSWORD@aws-0-us-west-2.pooler.supabase.com:5432/postgres
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Supabase CA certificate from Database Settings > SSL Configuration.
DATABASE_SSL_CA=config/prod-ca-2021.crt
# DATABASE_POOL_MAX=5
# PORT=3000
# APP_URL=https://your-render-domain.onrender.com

# Transactional mail uses SMTP, Resend, Mailpit, or log transport settings
# imported in `settings`; these environment values are their fallback.
# Set APP_URL in Render so booking emails can build absolute management links
# and admin login/reset emails point to the deployed Node service.

# One-time data transfer source. Use a read-only MySQL account and keep writes
# stopped during the final import. The transfer command is dry-run by default.
# MYSQL_URL=mysql://readonly:password@mysql-host:3306/voxelbooking?ssl-mode=REQUIRED
# MYSQL_SSL_CA=C:/path/to/mysql-ca.pem
